{
  "name": "velocity-email",
  "version": "1.0.0",
  "private": true,
  "description": "Velocity - Email at the Speed of Thought",
  "author": "Velocity",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently --kill-others \"next dev -p 3456\" \"wait-on http://127.0.0.1:3456 && NODE_ENV=development electron .\"",
    "electron:build": "next build && electron-builder --mac",
    "electron:build:dir": "next build && electron-builder --mac --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@types/dompurify": "^3.0.5",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.563.0",
    "next": "14.2.35",
    "next-auth": "^4.24.13",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.6.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.velocity.email",
    "productName": "Velocity",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "node_modules/**/*",
      "public/**/*",
      "src/**/*",
      "package.json",
      "next.config.mjs",
      "tsconfig.json",
      "tailwind.config.ts",
      "postcss.config.mjs"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "icon": "electron/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "backgroundColor": "#09090b",
      "title": "Velocity",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "extraResources": []
  }
}
